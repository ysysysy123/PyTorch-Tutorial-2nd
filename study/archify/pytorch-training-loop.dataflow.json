    "viewBox": [
      1080,
      590
    ],
    "views": [
      {
        "id": "training-hot-path",
        "label": "训练主链路",
        "focus": [
          "dataset",
          "loader",
          "model",
          "loss",
          "autograd",
          "optimizer"
        ],
        "note": "先把数据、模型、损失、反向传播和参数更新串成一条可运行链路。"
      },
      {
        "id": "tensor-and-graph",
        "label": "Tensor 与计算图",
        "focus": [
          "batch",
          "model",
          "loss",
          "autograd"
        ],
        "note": "理解 forward 如何记录关系，backward 如何沿计算图传播梯度。"
      },
      {
        "id": "experiment-evidence",
        "label": "实验证据",
        "focus": [
          "optimizer",
          "metrics",
          "checkpoint"
        ],
        "note": "把训练循环转成可复测的 loss、指标和模型保存结果。"
      }
    ]
  },
  "stages": [
    {
      "label": "数据"
    },
    {
      "label": "前向"
    },
    {
      "label": "反向"
    },
    {
      "label": "更新"
    },
    {
      "label": "证据"
    }
  ],
  "nodes": [
    {
      "id": "dataset",
      "type": "database",
      "label": "Dataset",

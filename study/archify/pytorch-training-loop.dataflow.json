      "stage": 0,
      "row": 0,
      "tag": "数据源"
    },
    {
      "id": "loader",
      "type": "backend",
      "label": "DataLoader",
      "sublabel": "batch / shuffle",
      "stage": 0,
      "row": 2,
      "tag": "迭代"
    },
    {
      "id": "batch",
      "type": "frontend",
      "label": "Tensor Batch",
      "sublabel": "shape · dtype · device",
      "stage": 1,
      "row": 0,
      "tag": "输入"
    },
    {
      "id": "model",
      "type": "backend",
      "label": "nn.Module",
      "sublabel": "forward → prediction",
      "stage": 1,
      "row": 2,
      "tag": "模型"
    },
    {
      "id": "loss",
      "type": "backend",
      "label": "Loss",

      "route": "straight",
      "labelAt": [
        100,
        200
      ]
    },
    {
      "id": "loader-batch",
      "from": "loader",
      "to": "batch",
      "label": "yield (x, y)",
      "classification": "data",
      "variant": "emphasis"
    },
    {
      "id": "batch-model",
      "from": "batch",
      "to": "model",
      "label": "forward",
      "classification": "tensor",
      "variant": "default",
      "labelAt": [
        315,
        200
      ]
    },
    {
      "id": "model-loss",
      "from": "model",
      "to": "loss",
      "label": "prediction",
      "classification": "tensor",
      "variant": "default"
    },
    {
      "id": "batch-loss",
      "from": "batch",
      "to": "loss",
      "label": "ground truth",
      "classification": "label",
      "variant": "dashed"
    },
    {
      "id": "loss-autograd",
      "from": "loss",
      "to": "autograd",
      "label": "loss.backward()",
      "classification": "gradient",
      "variant": "emphasis",
      "labelAt": [
        530,
        385
      ]
    },
    {
      "id": "autograd-optimizer",
      "from": "autograd",
      "to": "optimizer",
      "label": "parameter gradients",
      "classification": "gradient",
      "variant": "emphasis"
    },
    {
      "id": "loss-metrics",
      "from": "loss",
      "to": "metrics",
      "label": "record loss",
      "classification": "evidence",
      "variant": "default"
    },
    {
      "id": "optimizer-checkpoint",
      "from": "optimizer",
      "to": "checkpoint",
      "label": "save state",
      "classification": "evidence",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "先掌握五行训练代码",
      "items": [
        "zero_grad → forward → loss → backward → step",
        "loss.backward() 计算梯度，step() 才修改参数",
        "先用模拟 8×8 RGB 数据跑通闭环"
      ]
    },
    {
      "dot": "emerald",
      "title": "学习时的观察点",
      "items": [
        "每个 batch 的 shape / dtype / device",
        "计算图中的 requires_grad、grad 与 grad_fn",
        "训练与评估模式对 BatchNorm / Dropout 的影响"
      ]
    },
    {
      "dot": "amber",
      "title": "暂不扩张范围",
      "items": [
        "先完成上篇基础，再选择 CV、NLP 或 LLM 应用",
        "ONNX / TensorRT / 量化放到部署阶段",
        "每次实验保留可复测命令与指标"
      ]
    }
  ]
}
